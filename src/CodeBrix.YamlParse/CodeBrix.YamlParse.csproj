<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.YamlParse</AssemblyName>
    <RootNamespace>CodeBrix.YamlParse</RootNamespace>
    <!--
      SITUATIONAL EXCEPTION (documented in AGENT-README.txt): this library is a
      faithful port of YamlDotNet 18.1.0, whose entire public API surface depends
      on nullable-reference-type (`?`) annotations. Stripping them would change
      observable signatures and break fidelity with the upstream package, so NRT
      is left enabled here (the normal CodeBrix family rule is to leave it unset).
      Same precedent as CodeBrix.Platform.OpenGL (Silk.NET.Maths).
    -->
    <Nullable>enable</Nullable>
    <!--
      SITUATIONAL EXCEPTION (documented in AGENT-README.txt): the upstream
      YamlDotNet 18.1.0 public surface is hundreds of members, undocumented
      upstream (YamlDotNet itself suppresses CS1591). Retrofitting an XML doc
      comment onto every public member is out of scope for the v1 port, so the
      documentation file is turned off (same precedent as CodeBrix.AssemblyTools,
      a Mono.Cecil port). With the doc file off, CS1591 does not fire, so no
      <NoWarn> is needed.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.YamlParse.MitLicenseForever</PackageId>
    <Product>CodeBrix.YamlParse</Product>
    <Title>CodeBrix.YamlParse</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>CodeBrix.YamlParse is a fully managed .NET library for YAML, ported from YamlDotNet 18.1.0. It provides low-level parsing and emitting of YAML, a high-level representation model similar to XmlDocument, and a serialization library that reads and writes objects from and to YAML streams. Targets .NET 10 with no dependencies other than .NET.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.YamlParse</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.YamlParse</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) Antoine Aubry and contributors. Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>yaml;parser;serialization;deserialization;emitter;representation-model;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
